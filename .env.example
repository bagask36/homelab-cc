# Optional: client-side metrics poll interval in milliseconds (default 3000)
# NEXT_PUBLIC_METRICS_POLL_INTERVAL=3000

# App listen port on the host (network_mode: host — no port publish)
# PORT=3001

# PostgreSQL (required for historical metrics and authentication)
# DATABASE_URL=postgresql://homelab:homelab@127.0.0.1:5432/homelab
# POSTGRES_USER=homelab
# POSTGRES_PASSWORD=homelab
# POSTGRES_DB=homelab

# Authentication (required to protect dashboard and API)
# AUTH_SECRET must be at least 16 characters
# AUTH_SECRET=replace-with-a-long-random-string
# AUTH_USERNAME=admin
# AUTH_PASSWORD=changeme
# Set false for HTTP (LAN/Tailscale); true when behind HTTPS
# AUTH_COOKIE_SECURE=false

# Docker Engine socket path (server-side only)
# DOCKER_SOCKET=/var/run/docker.sock

# Host filesystem root inside the container (for storage metrics in Docker)
# Compose mounts host / at this path with :ro,rslave
# HOST_FS_ROOT=/host
# HOST_FS_SOURCE=/

# Default host for service health checks (works with network_mode: host)
# SERVICE_HOST=127.0.0.1

# PostgreSQL health check target
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Open WebUI
# OPENWEBUI_URL=http://127.0.0.1:8080

# Nginx Proxy Manager
# NPM_URL=http://127.0.0.1:81

# Cloudflare Tunnel (cloudflared metrics endpoint)
# CLOUDFLARE_TUNNEL_METRICS_URL=http://127.0.0.1:20241/metrics

# Tunnel config management (/tunnel page)
# CLOUDFLARE_TUNNEL_ID=your-tunnel-uuid
# CLOUDFLARE_TUNNEL_CONFIG_PATH=/etc/cloudflared/config.yml
# CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=/etc/cloudflared/credentials.json
# CLOUDFLARE_TUNNEL_CONFIG_DIR=/etc/cloudflared
# Reload after apply — leave empty for auto SIGHUP (needs pid: host in compose).
# Do NOT use systemctl here when the dashboard runs in Docker (no systemd in container).
# CLOUDFLARE_TUNNEL_RELOAD_CMD=
